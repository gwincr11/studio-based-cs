#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR/src"

"$ROOT_DIR/scripts/bootstrap"
if [ ! -f .env ]; then
    cp .env.example .env
fi
if [ -z "${DATABASE_URL:-}" ] && grep -qx 'DATABASE_URL=postgresql:///studio_app' .env; then
    database_exists="$(psql -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = 'studio_app'")"
    if [ "$database_exists" != "1" ]; then
        createdb studio_app
    fi
fi
python3 -m flask --app src.app:create_app db upgrade
npm --prefix frontend run build
echo "Ready. Run scripts/start-app from the repository root."
